---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/config';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteConfig.description} />
    <title>{title}</title>
    <meta property="og:title" content={siteConfig.name} />
    <meta property="og:description" content={siteConfig.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.siteUrl} />
    <meta property="og:image" content={`${siteConfig.siteUrl}/demo-poster-og.png`} />
    <meta property="og:image:alt" content="offline-banner — a yellow strip appears on the desktop when the network dies and slides away on recovery" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteConfig.name} />
    <meta name="twitter:description" content={siteConfig.ogDescription} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}/demo-poster-og.png`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={siteConfig.siteUrl} />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#11111b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5fa" media="(prefers-color-scheme: light)" />
    <script is:inline src="/js/theme-init.js"></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "offline-banner",
      "description": siteConfig.description,
      "url": siteConfig.siteUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "NixOS, Linux",
      "license": "https://opensource.org/licenses/MIT",
      "author": {
        "@type": "Person",
        "name": "LarsArtmann",
        "url": siteConfig.author.url
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": "offline-banner demo — 24 seconds",
      "description": "The offline banner appearing when the network dies and sliding away on recovery — debounce, reason caption, last-online tick, push-down animation.",
      "thumbnailUrl": [`${siteConfig.siteUrl}/demo-poster-og.png`],
      "uploadDate": "2026-10-17",
      "contentUrl": `${siteConfig.siteUrl}/demo.mp4`,
      "embedUrl": siteConfig.siteUrl,
      "duration": "PT24S"
    })} />
  </head>
  <body class="font-sans bg-bg-primary text-text-secondary antialiased leading-relaxed">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:text-on-accent focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
