---
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';

const without = [
  'Dead call, stalled build, endless spinner — nothing on screen says it\'s not your fault.',
  'The NM tray icon reads "connecting…" on a static-IP uplink that was never NM-managed.',
  'One bar widget covers one screen; the other two lie to you.',
];
const withBanner = [
  'A yellow strip slides in on every monitor ~10 s after the network is actually gone.',
  'It says why: "Network link is down" vs "No internet connection" — and how long ("last online 4m 12s ago").',
  'The first clean probe slides it away and re-arms for the next outage.',
];
---

<SectionHeader eyebrow="Without / With" title="The difference is on screen." subtitle="Connectivity loss stops being a mystery and becomes a warning." />

<div class="grid gap-4 md:grid-cols-2 text-left max-w-4xl mx-auto">
  <div class="rounded-xl border border-border bg-bg-card overflow-hidden">
    <div class="flex items-center gap-2 px-4 py-2.5 border-b border-border bg-[#ff5555]/5">
      <Icon name="close" size={16} />
      <span class="text-sm font-semibold text-text-secondary">Without offline-banner</span>
    </div>
    <div class="p-4 space-y-3">
      {without.map((line) => (
        <div class="flex gap-2.5 text-sm leading-relaxed">
          <span class="text-[#ff5555] mt-0.5 flex-none"><Icon name="close" size={14} /></span>
          <span class="text-text-muted">{line}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="rounded-xl border border-accent/30 bg-bg-card overflow-hidden">
    <div class="flex items-center gap-2 px-4 py-2.5 border-b border-border bg-accent/5">
      <Icon name="check" size={16} />
      <span class="text-sm font-semibold text-accent">With offline-banner</span>
    </div>
    <div class="p-4 space-y-3">
      {withBanner.map((line) => (
        <div class="flex gap-2.5 text-sm leading-relaxed">
          <span class="text-accent mt-0.5 flex-none"><Icon name="check" size={14} /></span>
          <span class="text-text-muted">{line}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<p class="text-center mt-6 text-sm text-text-muted">
  One boolean in your config. Every screen tells the truth.
</p>
<p class="text-center mt-2 text-xs text-text-muted">
  Behavior as shipped in v0.1.0 — see the FEATURES inventory for per-claim evidence.
</p>
