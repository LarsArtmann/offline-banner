---
export interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 32, height = 32, class: className } = Astro.props;
---

<svg class={className} width={width} height={height} viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="offline-banner logo">
  <defs>
    <linearGradient id="ob-mark" x1="2" y1="2" x2="26" y2="26" gradientUnits="userSpaceOnUse">
      <stop stop-color="#f2e06a" />
      <stop offset="1" stop-color="#e8d44d" />
    </linearGradient>
  </defs>
  <rect width="28" height="28" rx="7" fill="#1e1e2e" />
  <rect x="3" y="6" width="22" height="6" rx="1.5" fill="url(#ob-mark)" />
  <circle cx="10" cy="9" r="1" fill="#1e1e2e" />
  <circle cx="13.5" cy="9" r="1" fill="#1e1e2e" />
  <rect x="3" y="15" width="14" height="3.5" rx="1.5" fill="#45475a" />
  <rect x="3" y="20.5" width="9" height="3.5" rx="1.5" fill="#313244" />
</svg>
