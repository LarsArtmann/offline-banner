{
  "name": "offline-banner-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website and documentation for offline-banner — a yellow top-strip offline banner for NixOS desktops",
  "keywords": [
    "astro",
    "nixos",
    "nix-flake",
    "wayland",
    "layer-shell",
    "quickshell",
    "starlight",
    "offline-banner"
  ],
  "homepage": "https://offline-banner.lars.software",
  "bugs": "https://github.com/LarsArtmann/offline-banner/issues",
  "license": "MIT",
  "author": "LarsArtmann <lars@larsartmann.com> (https://larsartmann.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/LarsArtmann/offline-banner.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-csp.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.7",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "astro-og-canvas": "^0.13.2",
    "canvaskit-wasm": "0.42.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "html-validate": "^11.17.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "devalue": "5.8.1",
    "vite": "8.1.5",
    "yaml": "2.8.3"
  },
  "packageManager": "pnpm@11.20.0"
}
